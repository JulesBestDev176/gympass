generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ENUMS ────────────────────────────────────────────

enum UserRole {
  ADMIN
  GERANT
}

enum SubscriptionStatus {
  ACTIF
  EXPIRE_DEMAIN
  EXPIRE
  SEANCE_DISPONIBLE
  SEANCE_CONSOMMEE
  CARTE_DESACTIVEE
  SANS_ABONNEMENT
}

enum PaymentType {
  ABONNEMENT
  SEANCE_UNIQUE
  RECHARGE_CARTE
  INSCRIPTION
}

enum PaymentMode {
  ESPECES
  ORANGE_MONEY
  WAVE
  CHEQUE
  VIREMENT
  AUTRE
}

enum NotifType {
  EXPIRE_DEMAIN
  EXPIRATION
  PAIEMENT
  INSCRIPTION
  SYSTEME
}

enum GymStatut {
  ACTIF
  INACTIF
  SUSPENDU
}

// ─────────────────────────── GYM ──────────────────────────────────────────────

model Gym {
  id    String @id @default(cuid())
  nom   String
  ville String @default("Dakar")
  pays  String @default("SN")
  slug  String @unique // ex: "gymdakarplateau"

  memberCounter Int @default(0) // last allocated matricule; never decremented

  // Tarification
  fraisInscription  Int @default(5000)
  prixMensualite    Int @default(25000)
  dureeMensualite   Int @default(30)   // jours
  prixSeance        Int @default(2500)

  // Paramètres scanner
  antiDoubleScanSec Int @default(5)

  statut    GymStatut @default(ACTIF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingAccount GymBillingAccount?
  platformInvoices PlatformInvoice[]
  users         User[]
  members       Member[]
  notifications Notification[]
  payments      Payment[]
  bracelets     Bracelet[]
  braceletVentes BraceletVente[]

  @@map("gyms")
}

// ─────────────────────────── USER (Employé) ───────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  gymId              String
  nom                String
  prenom             String
  email              String    @unique
  telephone          String?
  passwordHash       String
  refreshTokenHash   String?
  role               UserRole  @default(GERANT)
  actif              Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  photoUrl           String?
  fcmToken           String?
  otpCode            String?
  otpExpiresAt       DateTime?
  otpAttempts        Int       @default(0)
  otpRequestedAt     DateTime?
  otpWindowStartedAt DateTime?
  otpRequests        Int       @default(0)
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  passwordRenewedAt  DateTime?
  authVersion        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  gym            Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payments       Payment[]
  entries        Entry[]
  braceletVentes BraceletVente[]

  @@index([gymId])
  @@unique([gymId, telephone])
  @@map("users")
}

// ─────────────────────────── MEMBER (Adhérent) ────────────────────────────────

model Member {
  registrationRequestId String?
  id             String   @id @default(cuid())
  gymId          String
  numeroCarte    String            // ex: "GP-2024-001"
  qrCode         String   @unique  // "GYMPASS-SN-{id}" — généré à la création
  nom            String
  prenom         String
  telephone      String
  photoUrl       String?
  carteActive    Boolean  @default(true)
  cardWhatsappStatus String?
  cardWhatsappAttemptedAt DateTime?
  cardWhatsappMessageId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gym            Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subscriptions  Subscription[]
  sessionCards   SessionCard[]
  payments       Payment[]
  entries        Entry[]

  @@index([gymId])
  @@unique([gymId, registrationRequestId])
  @@unique([gymId, numeroCarte])
  @@index([numeroCarte])
  @@index([qrCode])
  @@map("members")
}

// ─────────────────────────── SUBSCRIPTION ─────────────────────────────────────

model Subscription {
  id             String             @id @default(cuid())
  memberId       String
  formule        String             // "Mensuel"
  dateDebut      DateTime           @default(now())
  dateExpiration DateTime
  statut         SubscriptionStatus @default(ACTIF)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([dateExpiration])
  @@map("subscriptions")
}

// ─────────────────────────── SESSION CARD (Carte séances) ─────────────────────

model SessionCard {
  id               String   @id @default(cuid())
  memberId         String   @unique  // une seule carte par adhérent
  seancesRestantes Int      @default(0)
  seancesTotal     Int      @default(0)
  active           Boolean  @default(true)
  lastScannedAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recharges        Payment[]

  @@index([memberId])
  @@map("session_cards")
}

// ─────────────────────────── BRACELET (Séance unique sans adhérent) ───────────

model Bracelet {
  id        String   @id @default(cuid())
  gymId     String
  numero    String   // "B-001", "B-002", …
  qrCode    String   @unique  // "GYMPASS-BRACELET-{gymId}-{numero}"
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym    Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  ventes BraceletVente[]

  @@index([gymId])
  @@map("bracelets")
}

model BraceletVente {
  id          String   @id @default(cuid())
  gymId       String
  braceletId  String
  userId      String
  montantFcfa Int
  createdAt   DateTime @default(now())

  gym      Gym      @relation(fields: [gymId], references: [id])
  bracelet Bracelet @relation(fields: [braceletId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([gymId])
  @@index([braceletId])
  @@map("bracelet_ventes")
}

// ─────────────────────────── PAYMENT ──────────────────────────────────────────

model Payment {
  requestId String?
  receiptData Json?
  receiptWhatsappStatus String?
  receiptWhatsappAttemptedAt DateTime?
  receiptWhatsappMessageId String?
  receiptWhatsappRecipient String?
  id            String      @id @default(cuid())
  gymId         String
  memberId      String
  userId        String      // gérant qui a enregistré
  sessionCardId String?     // non null si RECHARGE_CARTE
  type          PaymentType
  formule       String      // "Mensuel", "Séance unique", "Recharge carte"
  montantFcfa   Int
  mode          PaymentMode @default(ESPECES)
  reference     String?     // ref Orange Money, Wave, etc.
  note          String?
  moisCouvert   String?     // format "YYYY-MM" — null si type != ABONNEMENT
  createdAt     DateTime    @default(now())

  gym           Gym         @relation(fields: [gymId], references: [id])
  member        Member      @relation(fields: [memberId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  sessionCard   SessionCard? @relation(fields: [sessionCardId], references: [id])

  @@index([gymId])
  @@index([memberId])
  @@index([userId])
  @@index([createdAt])
  @@unique([memberId, moisCouvert])
  @@unique([gymId, requestId])
  @@index([receiptWhatsappStatus, createdAt])
  @@map("payments")
}

// ─────────────────────────── ENTRY (Entrée / Scan) ────────────────────────────

model Entry {
  id                String             @id @default(cuid())
  memberId          String
  userId            String             // gérant qui a validé
  formule           String
  statut            SubscriptionStatus
  exceptionnel      Boolean            @default(false)
  motifExceptionnel String?
  createdAt         DateTime           @default(now())

  member            Member   @relation(fields: [memberId], references: [id])
  user              User     @relation(fields: [userId], references: [id])

  @@index([memberId])
  @@index([userId])
  @@index([createdAt])
  @@map("entries")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ██████████████████████████  G Y M B R O  ████████████████████████████████████
// ═══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────── GYMBRO ENUMS ─────────────────────────────────────

enum GymbroRole {
  USER
  COACH

  @@map("GymbroRole")
}

enum GymbroObjectif {
  PRISE_DE_MASSE
  FORCE
  REMISE_EN_FORME
  AUTRE
}

enum GymbroNiveau {
  DEBUTANT
  QUELQUES_MOIS
  PLUS_D_UN_AN
  INTERMEDIAIRE
}

enum GymbroTypeEquipement {
  SALLE_COMPLETE
  SALLE_BASIQUE
}

enum GymbroPreferenceEquipement {
  MACHINES
  HALTERES_BARRES
  MIXTE
}

enum GymbroSubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum GymbroMatchingStatus {
  PENDING
  MATCHED
  NO_MATCH
}

enum GymbroSessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  POSTPONED
}

enum GymbroSetStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum GymbroPhotoAngle {
  FACE
  PROFIL
  DOS
}

// ─────────────────────────── GYMBRO NEW ENUMS (Task 2) ────────────────────────

enum GymbroEditorialStatus {
  DRAFT
  COACH_REVIEW
  VALIDATED
  PUBLISHED
  RETIRED

  @@map("GymbroEditorialStatus")
}

enum GymbroProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXCUSED

  @@map("GymbroProgressStatus")
}

enum GymbroAvailability {
  AVAILABLE
  LOCKED_PREREQUISITE
  LOCKED_SCHEDULE
  BLOCKED_SAFETY
  BLOCKED_ENTITLEMENT
  READ_ONLY

  @@map("GymbroAvailability")
}

enum GymbroLoadConvention {
  TOTAL_EXTERNAL
  PER_DUMBBELL
  MACHINE_DISPLAY
  ADDED_PLATES
  ASSISTANCE
  BAND_SETUP
  BODYWEIGHT

  @@map("GymbroLoadConvention")
}

enum GymbroEffortRating {
  EASY
  AS_EXPECTED
  HARD

  @@map("GymbroEffortRating")
}

enum GymbroSessionFormat {
  STANDARD
  CIRCUIT

  @@map("GymbroSessionFormat")
}

enum GymbroSlotGrade {
  PRIMARY
  A1
  A2
  A3

  @@map("GymbroSlotGrade")
}

enum GymbroSlotRole {
  MAIN
  ACCESSORY
  WARMUP
  COOLDOWN

  @@map("GymbroSlotRole")
}

enum GymbroExerciseMetric {
  REPS
  DURATION
  DISTANCE

  @@map("GymbroExerciseMetric")
}

enum GymbroReviewStatus {
  NEEDS_REVIEW
  VALIDATED
  REJECTED

  @@map("GymbroReviewStatus")
}

enum GymbroMatchStatusV2 {
  MATCHED
  NEEDS_CLARIFICATION
  NEEDS_COACH_REVIEW
  NEEDS_MEDICAL_REVIEW
  NO_COVERAGE

  @@map("GymbroMatchStatusV2")
}

enum GymbroSubstitutionReason {
  ABSENT
  BROKEN
  BUSY
  UNKNOWN
  DISLIKED
  PAIN

  @@map("GymbroSubstitutionReason")
}

// ─────────────────────────── GYMBRO USER ──────────────────────────────────────

model GymbroUser {
  id                String      @id @default(cuid())
  email             String      @unique
  passwordHash      String
  refreshTokenHash  String?
  prenom            String
  nom               String
  telephone         String?     @unique
  role              GymbroRole  @default(USER)
  actif             Boolean     @default(true)
  phoneVerified     Boolean     @default(false)
  otpCode           String?
  otpExpiresAt      DateTime?
  fcmToken          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  profile           GymbroUserProfile?
  userPrograms      GymbroUserProgram[]
  subscriptions     GymbroSubscription[]
  weightLogs        GymbroWeightLog[]
  photos            GymbroPhoto[]
  bilans            GymbroBilan[]
  notifications     GymbroNotification[]
  profileSnapshots  GymbroProfileSnapshot[]

  @@map("gymbro_users")
}

// ─────────────────────────── GYMBRO USER PROFILE ─────────────────────────────

model GymbroUserProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    GymbroUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Étape 1 — Objectif
  objectifPrincipal       GymbroObjectif?
  objectifSecondaire      GymbroObjectif?
  descriptionPhysique     String?

  // Étape 2 — Profil physique
  age                     Int?
  tailleCm                Int?
  poidsKg                 Float?
  dateDernierePesee       DateTime?
  poidsSouhaiteKg         Float?

  // Étape 3 — Disponibilités (saisie libre 2–6 jours)
  seancesParSemaine       Int?
  dureeMaxSeanceMin       Int?      // 60, 75, 90
  joursPreferesJson       String?   // JSON ["lun","mar","ven"]
  changementPrevu         Boolean   @default(false)
  dateChangement          DateTime?
  seancesApresChangement  Int?

  // Étape 4 — Niveau & matériel (salle uniquement)
  niveauExperience        GymbroNiveau?
  typeEquipement          GymbroTypeEquipement?
  preferenceEquipement    GymbroPreferenceEquipement?

  // Étape 5 — Performances (facultatif)
  performancesJson        String?
  allerEchec              Boolean?

  // Étape 6 — Santé
  douleurs                String?
  blessures               String?
  heuresSommeil           Float?
  niveauFatigue           Int?
  restrictionMedicale     Boolean   @default(false)

  // Matching
  matchingStatus          GymbroMatchingStatus @default(PENDING)
  matchingProgramId       String?

  // Métadonnées
  questionnaireComplet    Boolean   @default(false)
  questionnaireV3         Json?     // Eight versioned steps; legacy answers remain unchanged.
  etapeActuelle           Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("gymbro_user_profiles")
}

// ─────────────────────────── GYMBRO EXERCISE ──────────────────────────────────

model GymbroExercise {
  id                     String   @id @default(cuid())
  nomFr                  String
  descriptionFr          String?
  instructionsFrJson     String?  // JSON ["étape 1", "étape 2"]
  groupeMusculaire       String
  musclesPrimairesJson   String   // JSON ["pectoraux"]
  musclesSecondairesJson String?
  equipementRequis       String
  difficulte             String?  // "débutant" | "intermédiaire" | "avancé"
  photoExerciceUrl       String?  // MinIO — photo de l'exercice (propriétaire GymBro)
  photoMuscleUrl         String?  // MinIO — highlight musculaire (pec.png, biceps.png…)
  actif                  Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  mediaSource            String?
  mediaSourceId          String?
  mediaSourceRevision    String?
  animationReviewedAt    DateTime?

  sessionExercises       GymbroSessionExercise[]
  slotOptions            GymbroProgramSlotOption[]
  substitutionsFrom      GymbroExerciseSubstitutionRule[] @relation("SubFrom")
  substitutionsTo        GymbroExerciseSubstitutionRule[] @relation("SubTo")
  assignmentExercises    GymbroAssignmentExercise[]

  @@unique([mediaSource, mediaSourceId])

  @@map("gymbro_exercises")
}

// ─────────────────────────── GYMBRO PROGRAM FAMILY ───────────────────────────

model GymbroProgramFamily {
  id                  String          @id @default(cuid())
  familyCode          String          @unique  // "P01", "P02", …
  goalCoverage        String[]        // ["PRISE_DE_MASSE","FORCE"]
  prescriptionPolicy  String
  progressionPolicy   String
  maxSessionMinutes   Int
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  programs            GymbroProgram[]

  @@map("gymbro_program_families")
}

// ─────────────────────────── GYMBRO PROGRAM ───────────────────────────────────

model GymbroProgram {
  id                  String               @id @default(cuid())
  nom                 String
  description         String?
  objectif            GymbroObjectif
  niveauMin           GymbroNiveau
  niveauMax           GymbroNiveau
  seancesParSemaine   Int                  // nombre de jours/semaine
  typeEquipement      GymbroTypeEquipement @default(SALLE_COMPLETE)
  dureeSeanceMin      Int                  // durée moyenne d'une séance (minutes)
  nbSemaines          Int                  @default(12)
  actif               Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // ── Task 2 additions (all nullable — no existing row affected) ──
  familyId            String?
  family              GymbroProgramFamily? @relation(fields: [familyId], references: [id])
  versionCode         String?              @unique        // "P01-L", "P01-M", nullable until migrated
  editorialStatus     GymbroEditorialStatus?
  checksum            String?
  prescriptionPolicy  String?
  progressionPolicy   String?
  maxSessionMinutes   Int?
  reviewedAt          DateTime?
  reviewAuthor        String?
  publishedAt         DateTime?

  phases              GymbroProgramPhase[]
  userPrograms        GymbroUserProgram[]

  @@map("gymbro_programs")
}

model GymbroProgramPhase {
  id          String        @id @default(cuid())
  programId   String
  program     GymbroProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  numero      Int           // 1, 2, 3
  nom         String
  description String?
  createdAt   DateTime      @default(now())

  weeks       GymbroProgramWeek[]

  @@index([programId])
  @@map("gymbro_program_phases")
}

model GymbroProgramWeek {
  id          String             @id @default(cuid())
  phaseId     String
  phase       GymbroProgramPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  numero      Int                // 1–12
  estDecharge Boolean            @default(false)
  createdAt   DateTime           @default(now())

  sessions    GymbroProgramSession[]

  @@index([phaseId])
  @@map("gymbro_program_weeks")
}

model GymbroProgramSession {
  id          String            @id @default(cuid())
  weekId      String
  week        GymbroProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  numero      Int               // 1, 2, 3… (ordre dans la semaine)
  nom         String            // "Séance A — Push"
  description String?
  createdAt   DateTime          @default(now())

  // ── Task 2 additions ──
  blueprintCode         String?
  occurrenceCode        String?
  sessionFormat         GymbroSessionFormat @default(STANDARD)
  rounds                Int?
  betweenExerciseRestSec Int?
  betweenRoundRestSec    Int?
  estimatedSeconds      Int?
  measuredSeconds       Int?

  exercises   GymbroSessionExercise[]
  userSessions GymbroUserSession[]

  @@index([weekId])
  @@map("gymbro_program_sessions")
}

model GymbroSessionExercise {
  id                  String               @id @default(cuid())
  sessionId           String
  session             GymbroProgramSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId          String
  exercise            GymbroExercise       @relation(fields: [exerciseId], references: [id])
  ordre               Int
  nbSeries            Int
  repsMin             Int
  repsMax             Int
  tempsReposSec       Int                  @default(90)
  chargeDepart        Float?
  notes               String?
  createdAt           DateTime             @default(now())

  // ── Task 2 additions ──
  slotCode              String?
  slotRole              GymbroSlotRole?
  metric                GymbroExerciseMetric?
  workingSets           Int?
  repsMin2              Int?
  repsMax2              Int?
  durationMinSec        Int?
  durationMaxSec        Int?
  distanceMinM          Int?
  distanceMaxM          Int?
  targetRirMin          Int?
  targetRirMax          Int?
  restTargetSec         Int?
  restAllowedMaxSec     Int?
  loadConvention        GymbroLoadConvention?
  initialLoadKg         Decimal?             @db.Decimal(10, 3)
  required              Boolean              @default(true)

  sets                GymbroUserSet[]
  slotOptions         GymbroProgramSlotOption[]
  assignmentExercises GymbroAssignmentExercise[]

  @@index([sessionId])
  @@index([exerciseId])
  @@map("gymbro_session_exercises")
}

// ─────────────────────────── GYMBRO PROGRAM SLOT OPTION ──────────────────────

model GymbroProgramSlotOption {
  id                  String               @id @default(cuid())
  sessionExerciseId   String
  sessionExercise     GymbroSessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  exerciseId          String
  exercise            GymbroExercise       @relation(fields: [exerciseId], references: [id])
  grade               GymbroSlotGrade      @default(PRIMARY)
  priority            Int
  approved            Boolean              @default(false)
  prescriptionOverride Json?               // Partial<Prescription> as JSON

  @@index([sessionExerciseId])
  @@index([exerciseId])
  @@map("gymbro_program_slot_options")
}

// ─────────────────────────── GYMBRO EXERCISE SUBSTITUTION RULE ───────────────

model GymbroExerciseSubstitutionRule {
  id                  String            @id @default(cuid())
  fromExerciseId      String
  fromExercise        GymbroExercise    @relation("SubFrom", fields: [fromExerciseId], references: [id])
  toExerciseId        String
  toExercise          GymbroExercise    @relation("SubTo", fields: [toExerciseId], references: [id])
  grade               GymbroSlotGrade
  reason              GymbroSubstitutionReason?
  conditions          Json?
  recalibrateLoad     Boolean           @default(false)
  reviewStatus        GymbroReviewStatus @default(NEEDS_REVIEW)
  reviewedAt          DateTime?
  reviewAuthor        String?
  createdAt           DateTime          @default(now())

  @@unique([fromExerciseId, toExerciseId, grade])
  @@index([fromExerciseId])
  @@map("gymbro_exercise_substitution_rules")
}

// ─────────────────────────── GYMBRO PROFILE SNAPSHOT ─────────────────────────

model GymbroProfileSnapshot {
  id              String          @id @default(cuid())
  userId          String
  user            GymbroUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemaVersion   String          // "gymbro-questionnaire/3"
  revision        Int
  normalizedJson  Json            // NormalizedProfile JSON
  safetyStatus    GymbroMatchStatusV2
  createdAt       DateTime        @default(now())

  matchingDecisions GymbroMatchingDecision[]
  userPrograms      GymbroUserProgram[]

  @@index([userId])
  @@map("gymbro_profile_snapshots")
}

// ─────────────────────────── GYMBRO MATCHING DECISION ────────────────────────

model GymbroMatchingDecision {
  id               String               @id @default(cuid())
  profileSnapshotId String
  profileSnapshot  GymbroProfileSnapshot @relation(fields: [profileSnapshotId], references: [id])
  status           GymbroMatchStatusV2
  score            Int?
  versionCode      String?
  reasonCodesJson  String[]
  rulesVersion     String
  decidedAt        DateTime             @default(now())

  userProgram      GymbroUserProgram?

  @@index([profileSnapshotId])
  @@map("gymbro_matching_decisions")
}

// ─────────────────────────── GYMBRO USER PROGRAM ─────────────────────────────

model GymbroUserProgram {
  id            String        @id @default(cuid())
  userId        String
  user          GymbroUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId     String
  program       GymbroProgram @relation(fields: [programId], references: [id])
  dateDebut     DateTime      @default(now())
  dateFin       DateTime?
  version       Int           @default(1)
  actif         Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // ── Task 2 additions ──
  profileSnapshotId   String?
  profileSnapshot     GymbroProfileSnapshot? @relation(fields: [profileSnapshotId], references: [id])
  matchingDecisionId  String?                @unique
  matchingDecision    GymbroMatchingDecision? @relation(fields: [matchingDecisionId], references: [id])
  assignmentRevision  Int                    @default(1)
  calendarPolicy      String?
  inventorySnapshotJson Json?

  sessions            GymbroUserSession[]
  adjustments         GymbroProgramAdjustment[]
  progressionNodes    GymbroProgressionNode[]
  assignmentExercises GymbroAssignmentExercise[]

  @@index([userId])
  @@map("gymbro_user_programs")
}

// ─────────────────────────── GYMBRO USER SESSION ──────────────────────────────

model GymbroUserSession {
  id               String               @id @default(cuid())
  userProgramId    String
  userProgram      GymbroUserProgram    @relation(fields: [userProgramId], references: [id], onDelete: Cascade)
  programSessionId String
  programSession   GymbroProgramSession @relation(fields: [programSessionId], references: [id])
  statut           GymbroSessionStatus  @default(PLANNED)
  datePrevue       DateTime?
  dateDebut        DateTime?
  dateFin          DateTime?
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // ── Task 2 additions ──
  progressionNodeId   String?   @unique
  progressionNode     GymbroProgressionNode? @relation(fields: [progressionNodeId], references: [id])
  effortRating        GymbroEffortRating?
  interruptedForPain  Boolean @default(false)
  actualSeconds       Int?

  sets             GymbroUserSet[]

  @@index([userProgramId])
  @@map("gymbro_user_sessions")
}

// ─────────────────────────── GYMBRO USER SET ──────────────────────────────────

model GymbroUserSet {
  id                  String                @id @default(cuid())
  userSessionId       String
  userSession         GymbroUserSession     @relation(fields: [userSessionId], references: [id], onDelete: Cascade)
  sessionExerciseId   String
  sessionExercise     GymbroSessionExercise @relation(fields: [sessionExerciseId], references: [id])
  numeroSerie         Int
  chargeProposee      Float?
  chargeAcceptee      Float?
  chargeRealisee      Float?
  repsRealisees       Int?
  statut              GymbroSetStatus       @default(PENDING)
  difficulte          Int?                  // 1–5 (RPE subjectif)
  douleur             Boolean               @default(false)
  notes               String?
  createdAt           DateTime              @default(now())

  // ── Task 2 additions ──
  effortRating        GymbroEffortRating?
  rirActual           Int?
  loadKgDecimal       Decimal?  @db.Decimal(10, 3)
  loadConvention      GymbroLoadConvention?

  @@index([userSessionId])
  @@index([sessionExerciseId])
  @@map("gymbro_user_sets")
}

// ─────────────────────────── GYMBRO SUBSCRIPTION ─────────────────────────────

model GymbroSubscription {
  id              String                    @id @default(cuid())
  userId          String
  user            GymbroUser                @relation(fields: [userId], references: [id], onDelete: Cascade)
  statut          GymbroSubscriptionStatus  @default(ACTIVE)
  dateDebut       DateTime                  @default(now())
  dateExpiration  DateTime
  readOnlyUntil   DateTime?                 // 30j après expiration
  montantFcfa     Int
  createdById     String?                   // ID admin gympass qui a créé
  note            String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([userId])
  @@index([dateExpiration])
  @@map("gymbro_subscriptions")
}

// ─────────────────────────── GYMBRO WEIGHT LOG ────────────────────────────────

model GymbroWeightLog {
  id        String     @id @default(cuid())
  userId    String
  user      GymbroUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  poidsKg   Float
  date      DateTime   @default(now())
  note      String?

  @@index([userId])
  @@map("gymbro_weight_logs")
}

// ─────────────────────────── GYMBRO PHOTO ────────────────────────────────────

model GymbroPhoto {
  id        String          @id @default(cuid())
  userId    String
  user      GymbroUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  angle     GymbroPhotoAngle @default(FACE)
  date      DateTime        @default(now())

  @@index([userId])
  @@map("gymbro_photos")
}

// ─────────────────────────── GYMBRO BILAN ─────────────────────────────────────

model GymbroBilan {
  id              String     @id @default(cuid())
  userId          String
  user            GymbroUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  semaine         Int        // numéro de semaine du programme
  seancesTotal    Int
  seancesReussies Int
  volumeTotal     Float?     // kg total soulevé
  poidsDebut      Float?
  poidsFin        Float?
  notes           String?
  createdAt       DateTime   @default(now())

  @@index([userId])
  @@map("gymbro_bilans")
}

// ─────────────────────────── GYMBRO PROGRAM ADJUSTMENT ───────────────────────

model GymbroProgramAdjustment {
  id            String            @id @default(cuid())
  userProgramId String
  userProgram   GymbroUserProgram @relation(fields: [userProgramId], references: [id], onDelete: Cascade)
  type          String            // "CHARGE" | "SEANCE_DEPLACEE" | "JOURS_MODIFIES"
  description   String
  version       Int
  createdAt     DateTime          @default(now())

  // ── Task 2 additions ──
  actorId             String?
  beforeJson          Json?
  afterJson           Json?
  adjustmentRevision  Int?
  progressionNodeId   String?

  @@index([userProgramId])
  @@map("gymbro_program_adjustments")
}

// ─────────────────────────── GYMBRO NOTIFICATION ─────────────────────────────

model GymbroNotification {
  id        String     @id @default(cuid())
  userId    String
  user      GymbroUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  titre     String
  message   String
  type      String     // "ABONNEMENT" | "SEANCE" | "PROGRESSION" | "BILAN"
  lue       Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([userId])
  @@map("gymbro_notifications")
}

// ─────────────────────────── GYMBRO PROGRESSION NODE ─────────────────────────

model GymbroProgressionNode {
  id                  String               @id @default(cuid())
  userProgramId       String
  userProgram         GymbroUserProgram    @relation(fields: [userProgramId], references: [id], onDelete: Cascade)
  occurrenceCode      String
  sequence            Int                  // 1-based order in assignment
  weekNumber          Int
  phaseNumber         Int
  title               String
  prerequisiteNodeId  String?
  prerequisiteNode    GymbroProgressionNode? @relation("NodePrereq", fields: [prerequisiteNodeId], references: [id])
  dependents          GymbroProgressionNode[] @relation("NodePrereq")
  progressStatus      GymbroProgressStatus @default(NOT_STARTED)
  availability        GymbroAvailability   @default(LOCKED_PREREQUISITE)
  reasonCode          String?
  reasonLabel         String?
  scheduledAt         DateTime?
  availableAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  excusedAt           DateTime?
  excuseAuthor        String?
  excuseReason        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  userSession         GymbroUserSession?

  @@unique([userProgramId, sequence])
  @@unique([userProgramId, occurrenceCode])
  @@index([userProgramId])
  @@index([prerequisiteNodeId])
  @@map("gymbro_progression_nodes")
}

// ─────────────────────────── GYMBRO ASSIGNMENT EXERCISE ──────────────────────

model GymbroAssignmentExercise {
  id                  String               @id @default(cuid())
  userProgramId       String
  userProgram         GymbroUserProgram    @relation(fields: [userProgramId], references: [id], onDelete: Cascade)
  sessionExerciseId   String
  sessionExercise     GymbroSessionExercise @relation(fields: [sessionExerciseId], references: [id])
  resolvedExerciseId  String
  resolvedExercise    GymbroExercise       @relation(fields: [resolvedExerciseId], references: [id])
  selectedGrade       GymbroSlotGrade      @default(PRIMARY)
  equipmentId         String?
  prescription        Json                 // final Prescription JSON
  loadConvention      GymbroLoadConvention
  initialLoadKg       Decimal?             @db.Decimal(10, 3)
  bindingVersion      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([userProgramId, sessionExerciseId])
  @@index([userProgramId])
  @@index([sessionExerciseId])
  @@map("gymbro_assignment_exercises")
}

