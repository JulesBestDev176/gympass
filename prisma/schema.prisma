generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ENUMS ────────────────────────────────────────────

enum AppReleaseStatus {
  DRAFT
  PUBLISHED
}

model AppRelease {
  id          String @id @default(uuid())
  packageName String
  versionName String
  versionCode Int
  notes       String
  sizeBytes   Int
  sha256      String
  objectKey   String @unique
  status      AppReleaseStatus @default(DRAFT)
  createdById String
  createdAt   DateTime @default(now())
  publishedAt DateTime?

  @@index([status, versionCode])
  @@index([createdAt, id])
  @@map("app_releases")
}

enum UserRole {
  ADMIN
  GERANT
}

enum SubscriptionStatus {
  ACTIF
  EXPIRE_DEMAIN
  EXPIRE
  SEANCE_DISPONIBLE
  SEANCE_CONSOMMEE
  CARTE_DESACTIVEE
  SANS_ABONNEMENT
}

enum PaymentType {
  ABONNEMENT
  SEANCE_UNIQUE
  RECHARGE_CARTE
  INSCRIPTION
}

enum PaymentMode {
  ESPECES
  ORANGE_MONEY
  WAVE
  CHEQUE
  VIREMENT
  AUTRE
}

enum NotifType {
  EXPIRE_DEMAIN
  EXPIRATION
  PAIEMENT
  INSCRIPTION
  SYSTEME
}

enum GymStatut {
  ACTIF
  INACTIF
  SUSPENDU
}

// ─────────────────────────── GYM ──────────────────────────────────────────────

model Gym {
  id    String @id @default(cuid())
  nom   String
  ville String @default("Dakar")
  pays  String @default("SN")
  slug  String @unique // ex: "gymdakarplateau"

  memberCounter Int @default(0) // last allocated matricule; never decremented

  // Tarification
  fraisInscription  Int @default(5000)
  prixMensualite    Int @default(25000)
  dureeMensualite   Int @default(30)   // jours
  prixSeance        Int @default(2500)

  // Paramètres scanner
  antiDoubleScanSec Int @default(5)

  statut    GymStatut @default(ACTIF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingAccount GymBillingAccount?
  platformInvoices PlatformInvoice[]
  users         User[]
  members       Member[]
  notifications Notification[]
  payments      Payment[]
  bracelets Bracelet[]
  braceletVentes BraceletVente[]

  @@map("gyms")
  braceletSales BraceletSale[]

}

// ─────────────────────────── USER (Employé) ───────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  gymId              String
  nom                String
  prenom             String
  email              String    @unique
  telephone          String?
  passwordHash       String
  sessions           AuthSession[]
  refreshTokenHash   String?
  role               UserRole  @default(GERANT)
  actif              Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  photoUrl           String?
  fcmToken           String?
  otpCode            String?
  otpExpiresAt       DateTime?
  otpAttempts        Int       @default(0)
  otpRequestedAt     DateTime?
  otpWindowStartedAt DateTime?
  otpRequests        Int       @default(0)
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  passwordRenewedAt  DateTime?
  authVersion        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  gym      Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payments Payment[]
  entries  Entry[]
  braceletVentes BraceletVente[]

  @@index([gymId])
  @@unique([gymId, telephone])
  @@map("users")
  braceletSales BraceletSale[]

}

// ─────────────────────────── MEMBER (Adhérent) ────────────────────────────────

model Member {
  registrationRequestId String?
  id             String   @id @default(cuid())
  gymId          String
  numeroCarte    String            // ex: "GP-2024-001"
  qrCode         String   @unique  // "GYMPASS-SN-{id}" — généré à la création
  nom            String
  prenom         String
  telephone      String
  photoUrl       String?
  carteActive    Boolean  @default(true)
  cardWhatsappStatus String?
  cardWhatsappAttemptedAt DateTime?
  cardWhatsappMessageId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gym            Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subscriptions  Subscription[]
  sessionCards   SessionCard[]
  payments       Payment[]
  entries        Entry[]

  @@index([gymId])
  @@unique([gymId, registrationRequestId])
  @@unique([gymId, numeroCarte])
  @@index([numeroCarte])
  @@index([qrCode])
  @@map("members")
}

// ─────────────────────────── SUBSCRIPTION ─────────────────────────────────────

model Subscription {
  id             String             @id @default(cuid())
  memberId       String
  formule        String             // "Mensuel"
  dateDebut      DateTime           @default(now())
  dateExpiration DateTime
  statut         SubscriptionStatus @default(ACTIF)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([dateExpiration])
  @@map("subscriptions")
}

// ─────────────────────────── SESSION CARD (Carte séances) ─────────────────────

model SessionCard {
  id               String   @id @default(cuid())
  memberId         String
  qrCode           String   @unique  // "GYMPASS-CARTE-{id}"
  seancesRestantes Int      @default(0)
  seancesTotal     Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recharges        Payment[]

  @@index([memberId])
  @@map("session_cards")
}

// ─────────────────────────── PAYMENT ──────────────────────────────────────────

model Bracelet {
  id        String   @id @default(cuid())
  gymId     String
  numero    String   // "B-001", "B-002", …
  qrCode    String   @unique  // "GYMPASS-BRACELET-{gymId}-{numero}"
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym    Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  ventes BraceletVente[]

  @@index([gymId])
  @@map("bracelets")
  soldAt DateTime?

}

model BraceletVente {
  id          String   @id @default(cuid())
  gymId       String
  braceletId  String
  userId      String
  montantFcfa Int
  createdAt   DateTime @default(now())

  gym      Gym      @relation(fields: [gymId], references: [id])
  bracelet Bracelet @relation(fields: [braceletId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([gymId])
  @@index([braceletId])
  @@map("bracelet_ventes")
  saleId String?
  mode PaymentMode?
  disposableKey String? @unique
  sale BraceletSale? @relation(fields: [saleId], references: [id], onDelete: Restrict)

}

model Payment {
  requestId String?
  receiptData Json?
  receiptWhatsappStatus String?
  receiptWhatsappAttemptedAt DateTime?
  receiptWhatsappMessageId String?
  receiptWhatsappRecipient String?
  moisCouvert   String?
  id            String      @id @default(cuid())
  gymId         String
  memberId      String
  userId        String      // gérant qui a enregistré
  sessionCardId String?     // non null si RECHARGE_CARTE
  type          PaymentType
  formule       String      // "Mensuel", "Séance unique", "Recharge carte"
  montantFcfa   Int
  mode          PaymentMode @default(ESPECES)
  reference     String?     // ref Orange Money, Wave, etc.
  note          String?
  createdAt     DateTime    @default(now())

  gym           Gym         @relation(fields: [gymId], references: [id])
  member        Member      @relation(fields: [memberId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  sessionCard   SessionCard? @relation(fields: [sessionCardId], references: [id])

  @@index([gymId])
  @@index([memberId])
  @@index([userId])
  @@index([createdAt])
  @@unique([memberId, moisCouvert])
  @@unique([gymId, requestId])
  @@index([receiptWhatsappStatus, createdAt])
  @@map("payments")
}

// ─────────────────────────── ENTRY (Entrée / Scan) ────────────────────────────

model Entry {
  id                String             @id @default(cuid())
  memberId          String
  userId            String             // gérant qui a validé
  formule           String
  statut            SubscriptionStatus
  exceptionnel      Boolean            @default(false)
  motifExceptionnel String?
  createdAt         DateTime           @default(now())

  member            Member   @relation(fields: [memberId], references: [id])
  user              User     @relation(fields: [userId], references: [id])

  @@index([memberId])
  @@index([userId])
  @@index([createdAt])
  @@map("entries")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ██████████████████████████  G Y M B R O  ████████████████████████████████████
// ═══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────── GYMBRO ENUMS ─────────────────────────────────────

enum GymbroRole {
  USER
  COACH

  @@map("GymbroRole")
}

enum GymbroObjectif {
  PRISE_DE_MASSE
  FORCE
  REMISE_EN_FORME
  AUTRE
}

enum GymbroNiveau {
  DEBUTANT
  QUELQUES_MOIS
  PLUS_D_UN_AN
  INTERMEDIAIRE
}

enum GymbroTypeEquipement {
  SALLE_COMPLETE
  SALLE_BASIQUE
}

enum GymbroPreferenceEquipement {
  MACHINES
  HALTERES_BARRES
  MIXTE
}

enum GymbroSubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum GymbroMatchingStatus {
  PENDING
  MATCHED
  NO_MATCH
}

enum GymbroSessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  POSTPONED
}

enum GymbroSetStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum GymbroPhotoAngle {
  FACE
  PROFIL
  DOS
}

// ─────────────────────────── GYMBRO USER ──────────────────────────────────────

model GymbroUser {
  id                String      @id @default(cuid())
  email             String      @unique
  passwordHash      String
  refreshTokenHash  String?
  prenom            String
  nom               String
  telephone         String?     @unique
  role              GymbroRole  @default(USER)
  actif             Boolean     @default(true)
  phoneVerified     Boolean     @default(false)
  otpCode           String?
  otpExpiresAt      DateTime?
  fcmToken          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  profile           GymbroUserProfile?
  userPrograms      GymbroUserProgram[]
  subscriptions     GymbroSubscription[]
  weightLogs        GymbroWeightLog[]
  photos            GymbroPhoto[]
  bilans            GymbroBilan[]
  notifications     GymbroNotification[]

  @@map("gymbro_users")
}

// ─────────────────────────── GYMBRO USER PROFILE ─────────────────────────────

model GymbroUserProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    GymbroUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Étape 1 — Objectif
  objectifPrincipal       GymbroObjectif?
  objectifSecondaire      GymbroObjectif?
  descriptionPhysique     String?

  // Étape 2 — Profil physique
  age                     Int?
  tailleCm                Int?
  poidsKg                 Float?
  dateDernierePesee       DateTime?
  poidsSouhaiteKg         Float?

  // Étape 3 — Disponibilités (saisie libre 2–6 jours)
  seancesParSemaine       Int?
  dureeMaxSeanceMin       Int?      // 60, 75, 90
  joursPreferesJson       String?   // JSON ["lun","mar","ven"]
  changementPrevu         Boolean   @default(false)
  dateChangement          DateTime?
  seancesApresChangement  Int?

  // Étape 4 — Niveau & matériel (salle uniquement)
  niveauExperience        GymbroNiveau?
  typeEquipement          GymbroTypeEquipement?
  preferenceEquipement    GymbroPreferenceEquipement?

  // Étape 5 — Performances (facultatif)
  performancesJson        String?
  allerEchec              Boolean?

  // Étape 6 — Santé
  douleurs                String?
  blessures               String?
  heuresSommeil           Float?
  niveauFatigue           Int?
  restrictionMedicale     Boolean   @default(false)

  // Matching
  matchingStatus          GymbroMatchingStatus @default(PENDING)
  matchingProgramId       String?

  // Métadonnées
  questionnaireComplet    Boolean   @default(false)
  questionnaireV3         Json?     // Eight versioned steps; legacy answers remain unchanged.
  etapeActuelle           Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("gymbro_user_profiles")
}

// ─────────────────────────── GYMBRO EXERCISE ──────────────────────────────────

model GymbroExercise {
  id                     String   @id @default(cuid())
  nomFr                  String
  descriptionFr          String?
  instructionsFrJson     String?  // JSON ["étape 1", "étape 2"]
  groupeMusculaire       String
  musclesPrimairesJson   String   // JSON ["pectoraux"]
  musclesSecondairesJson String?
  equipementRequis       String
  difficulte             String?  // "débutant" | "intermédiaire" | "avancé"
  photoExerciceUrl       String?  // MinIO — photo de l'exercice (propriétaire GymBro)
  photoMuscleUrl         String?  // MinIO — highlight musculaire (pec.png, biceps.png…)
  actif                  Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  mediaSource            String?
  mediaSourceId          String?
  mediaSourceRevision    String?
  animationReviewedAt    DateTime?

  sessionExercises       GymbroSessionExercise[]

  @@unique([mediaSource, mediaSourceId])

  @@map("gymbro_exercises")
}

// ─────────────────────────── GYMBRO PROGRAM ───────────────────────────────────

model GymbroProgram {
  id                  String               @id @default(cuid())
  nom                 String
  description         String?
  objectif            GymbroObjectif
  niveauMin           GymbroNiveau
  niveauMax           GymbroNiveau
  seancesParSemaine   Int                  // nombre de jours/semaine
  typeEquipement      GymbroTypeEquipement @default(SALLE_COMPLETE)
  dureeSeanceMin      Int                  // durée moyenne d'une séance (minutes)
  nbSemaines          Int                  @default(12)
  actif               Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  phases              GymbroProgramPhase[]
  userPrograms        GymbroUserProgram[]

  @@map("gymbro_programs")
}

model GymbroProgramPhase {
  id          String        @id @default(cuid())
  programId   String
  program     GymbroProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  numero      Int           // 1, 2, 3
  nom         String
  description String?
  createdAt   DateTime      @default(now())

  weeks       GymbroProgramWeek[]

  @@index([programId])
  @@map("gymbro_program_phases")
}

model GymbroProgramWeek {
  id          String             @id @default(cuid())
  phaseId     String
  phase       GymbroProgramPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  numero      Int                // 1–12
  estDecharge Boolean            @default(false)
  createdAt   DateTime           @default(now())

  sessions    GymbroProgramSession[]

  @@index([phaseId])
  @@map("gymbro_program_weeks")
}

model GymbroProgramSession {
  id          String            @id @default(cuid())
  weekId      String
  week        GymbroProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  numero      Int               // 1, 2, 3… (ordre dans la semaine)
  nom         String            // "Séance A — Push"
  description String?
  createdAt   DateTime          @default(now())

  exercises   GymbroSessionExercise[]
  userSessions GymbroUserSession[]

  @@index([weekId])
  @@map("gymbro_program_sessions")
}

model GymbroSessionExercise {
  id                  String               @id @default(cuid())
  sessionId           String
  session             GymbroProgramSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId          String
  exercise            GymbroExercise       @relation(fields: [exerciseId], references: [id])
  ordre               Int
  nbSeries            Int
  repsMin             Int
  repsMax             Int
  tempsReposSec       Int                  @default(90)
  chargeDepart        Float?
  notes               String?
  createdAt           DateTime             @default(now())

  sets                GymbroUserSet[]

  @@index([sessionId])
  @@index([exerciseId])
  @@map("gymbro_session_exercises")
}

// ─────────────────────────── GYMBRO USER PROGRAM ─────────────────────────────

model GymbroUserProgram {
  id            String        @id @default(cuid())
  userId        String
  user          GymbroUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId     String
  program       GymbroProgram @relation(fields: [programId], references: [id])
  dateDebut     DateTime      @default(now())
  dateFin       DateTime?
  version       Int           @default(1)
  actif         Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sessions      GymbroUserSession[]
  adjustments   GymbroProgramAdjustment[]

  @@index([userId])
  @@map("gymbro_user_programs")
}

// ─────────────────────────── GYMBRO USER SESSION ──────────────────────────────

model GymbroUserSession {
  id               String               @id @default(cuid())
  userProgramId    String
  userProgram      GymbroUserProgram    @relation(fields: [userProgramId], references: [id], onDelete: Cascade)
  programSessionId String
  programSession   GymbroProgramSession @relation(fields: [programSessionId], references: [id])
  statut           GymbroSessionStatus  @default(PLANNED)
  datePrevue       DateTime?
  dateDebut        DateTime?
  dateFin          DateTime?
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  sets             GymbroUserSet[]

  @@index([userProgramId])
  @@map("gymbro_user_sessions")
}

// ─────────────────────────── GYMBRO USER SET ──────────────────────────────────

model GymbroUserSet {
  id                  String                @id @default(cuid())
  userSessionId       String
  userSession         GymbroUserSession     @relation(fields: [userSessionId], references: [id], onDelete: Cascade)
  sessionExerciseId   String
  sessionExercise     GymbroSessionExercise @relation(fields: [sessionExerciseId], references: [id])
  numeroSerie         Int
  chargeProposee      Float?
  chargeAcceptee      Float?
  chargeRealisee      Float?
  repsRealisees       Int?
  statut              GymbroSetStatus       @default(PENDING)
  difficulte          Int?                  // 1–5 (RPE subjectif)
  douleur             Boolean               @default(false)
  notes               String?
  createdAt           DateTime              @default(now())

  @@index([userSessionId])
  @@index([sessionExerciseId])
  @@map("gymbro_user_sets")
}

// ─────────────────────────── GYMBRO SUBSCRIPTION ─────────────────────────────

model GymbroSubscription {
  id              String                    @id @default(cuid())
  userId          String
  user            GymbroUser                @relation(fields: [userId], references: [id], onDelete: Cascade)
  statut          GymbroSubscriptionStatus  @default(ACTIVE)
  dateDebut       DateTime                  @default(now())
  dateExpiration  DateTime
  readOnlyUntil   DateTime?                 // 30j après expiration
  montantFcfa     Int
  createdById     String?                   // ID admin gympass qui a créé
  note            String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([userId])
  @@index([dateExpiration])
  @@map("gymbro_subscriptions")
}

// ─────────────────────────── GYMBRO WEIGHT LOG ────────────────────────────────

model GymbroWeightLog {
  id        String     @id @default(cuid())
  userId    String
  user      GymbroUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  poidsKg   Float
  date      DateTime   @default(now())
  note      String?

  @@index([userId])
  @@map("gymbro_weight_logs")
}

// ─────────────────────────── GYMBRO PHOTO ────────────────────────────────────

model GymbroPhoto {
  id        String          @id @default(cuid())
  userId    String
  user      GymbroUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  angle     GymbroPhotoAngle @default(FACE)
  date      DateTime        @default(now())

  @@index([userId])
  @@map("gymbro_photos")
}

// ─────────────────────────── GYMBRO BILAN ─────────────────────────────────────

model GymbroBilan {
  id              String     @id @default(cuid())
  userId          String
  user            GymbroUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  semaine         Int        // numéro de semaine du programme
  seancesTotal    Int
  seancesReussies Int
  volumeTotal     Float?     // kg total soulevé
  poidsDebut      Float?
  poidsFin        Float?
  notes           String?
  createdAt       DateTime   @default(now())

  @@index([userId])
  @@map("gymbro_bilans")
}

// ─────────────────────────── GYMBRO PROGRAM ADJUSTMENT ───────────────────────

model GymbroProgramAdjustment {
  id            String            @id @default(cuid())
  userProgramId String
  userProgram   GymbroUserProgram @relation(fields: [userProgramId], references: [id], onDelete: Cascade)
  type          String            // "CHARGE" | "SEANCE_DEPLACEE" | "JOURS_MODIFIES"
  description   String
  version       Int
  createdAt     DateTime          @default(now())

  @@index([userProgramId])
  @@map("gymbro_program_adjustments")
}

// ─────────────────────────── GYMBRO NOTIFICATION ─────────────────────────────

model GymbroNotification {
  id        String     @id @default(cuid())
  userId    String
  user      GymbroUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  titre     String
  message   String
  type      String     // "ABONNEMENT" | "SEANCE" | "PROGRESSION" | "BILAN"
  lue       Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([userId])
  @@map("gymbro_notifications")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ████████████████████  FIN GYMBRO  ███████████████████████████████████████████
// ═══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────── NOTIFICATION ─────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  gymId     String
  userId    String?   // null = broadcast tous les users du gym
  titre     String
  message   String
  type      NotifType
  lue       Boolean   @default(false)
  createdAt DateTime  @default(now())

  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([userId])
  @@index([lue])
  @@map("notifications")
}

enum PlatformInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model PlatformBillingSettings {
  id               String @id @default("global")
  monthlyPriceFcfa Int?
  graceDays        Int    @default(7)
  issuerName       String @default("")
  issuerAddress    String @default("")
  issuerEmail      String @default("")
  issuerPhone      String @default("")
  issuerTaxId      String @default("")
  invoiceFooter    String @default("")

  @@map("platform_billing_settings")
}

model GymBillingAccount {
  gymId            String    @id
  gym              Gym       @relation(fields: [gymId], references: [id], onDelete: Restrict)
  enabled          Boolean   @default(true)
  activatedAt      DateTime  @default(now())
  paidUntil        DateTime?
  anchorDay        Int?
  monthlyPriceFcfa Int?
  billingName      String    @default("")
  billingAddress   String    @default("")
  billingEmail     String    @default("")
  billingPhone     String    @default("")
  billingTaxId     String    @default("")

  @@map("gym_billing_accounts")
}

model PlatformInvoice {
  id                 String                   @id @default(cuid())
  number             String                   @unique
  gymId              String
  gym                Gym                      @relation(fields: [gymId], references: [id], onDelete: Restrict)
  gymName            String
  months             Int
  unitPriceFcfa      Int
  totalFcfa          Int
  paidFcfa           Int                      @default(0)
  status             PlatformInvoiceStatus    @default(UNPAID)
  issuedAt           DateTime                 @default(now())
  coveredFrom        DateTime?
  coveredUntil       DateTime?
  issuer             Json
  customer           Json
  footer             String
  cancellationReason String?
  createdById        String
  payments           PlatformBillingPayment[]
  commands           PlatformBillingCommand[]

  @@index([gymId, issuedAt])
  @@index([status, issuedAt])
  @@map("platform_invoices")
}

model PlatformBillingPayment {
  id           String          @id @default(cuid())
  invoiceId    String
  invoice      PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountFcfa   Int
  mode         PaymentMode
  reference    String?
  paidAt       DateTime        @default(now())
  recordedById String

  @@index([invoiceId])
  @@map("platform_billing_payments")
}

model PlatformBillingCommand {
  key         String          @id @db.Uuid
  fingerprint String
  invoiceId   String
  invoice     PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@map("platform_billing_commands")
}

model PlatformInvoiceCounter {
  year  Int @id
  value Int

  @@map("platform_invoice_counters")
}

model BraceletSale {
  id String @id @default(cuid())
  gymId String
  userId String
  requestId String
  mode PaymentMode?
  unitPrice Int
  totalFcfa Int
  quantity Int
  createdAt DateTime @default(now())
  gym Gym @relation(fields: [gymId], references: [id])
  user User @relation(fields: [userId], references: [id])
  items BraceletVente[]
  @@unique([gymId, requestId])
  @@index([gymId, createdAt])
  @@map("bracelet_sales")
}

model AuthSession {
  id               String   @id
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}
