DATABASE_URL="postgresql://user:password@localhost:5432/gympass_sn"
JWT_SECRET="change_me_in_production"
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=development

# GymDash super-admin (login dashboard)
GYMDASH_ADMIN_EMAIL="admin@gympass.sn"
GYMDASH_ADMIN_PASSWORD="GymDash2024!"

# MinIO
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="gympass"
MINIO_SECRET_KEY="gympass123"
MINIO_BUCKET="gympass"
MINIO_USE_SSL=false

# Firebase FCM (optionnel — push désactivées si variables absentes)
FIREBASE_PROJECT_ID="gympass-sn"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@gympass-sn.iam.gserviceaccount.com"

# Relayio self-hosted WhatsApp (aucun contenu de message dans les logs)
RELAYIO_API_KEY="relayio_xxxxxxxxxxxxxxxx"
RELAYIO_BASE_URL="https://relayio.minifootapp.com/v1"
RELAYIO_SESSION_ID=""

# Administrateurs plateforme autorisés dans GymDash (emails séparés par virgules).
# Requis en plus du JWT ADMIN et du secret GymDash, jamais exposé au navigateur.
GYMDASH_BILLING_ADMIN_EMAILS=""






# Private APK objects; MUST differ from the public photo bucket
MINIO_RELEASES_BUCKET=gympass-releases
GYMDASH_SECRET=""
